# Groq / Open-Source Models API Key
GROQ_API_KEY=your_groq_api_key_here

# Optional: Custom endpoint / proxy base URL if using an OpenAI-compatible gateway
# GROQ_BASE_URL=https://api.groq.com

# Optional model selection (defaults to available models from your dashboard)
# Versatile model for complex reasoning and routine analysis:
GROQ_MODEL_VERSATILE=openai/gpt-oss-120b

# Fast model for simple queries and real-time streaming:
GROQ_MODEL_FAST=openai/gpt-oss-20b
# Alternative fast model: qwen/qwen3.8-27b
